# Base URL of the expense-tracker API (expense-tracker-BE).
# Defaults to http://localhost:3000 when unset.
VITE_API_BASE_URL=http://localhost:3000

# Supabase project auth. Both must be set for login to be enabled; leave
# blank to run the app in its no-auth mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. When both are set, the login page shows a "Try the demo" button
# that signs in with these credentials. Safe to commit to the deploy config —
# the demo account's data resets on every login.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
